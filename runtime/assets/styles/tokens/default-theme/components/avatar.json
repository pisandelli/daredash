{
  "$description": "Tokens for the Avatar component",
  "$type": "object",
  "size": {
    "$description": "Base size (width/height) of the avatar",
    "$value": "{space.sl}"
  },
  "overlap": {
    "$description": "Negative margin for overlapping avatars in a group",
    "$value": "-0.75rem"
  },
  "border-radius": {
    "$value": "{border-radius.full}"
  },
  "background-color": {
    "$value": "{color.primary.100}"
  },
  "color": {
    "$description": "Text color (for initials)",
    "$value": "contrast-color({avatar.background-color})"
  },
  "random-palette": {
    "1": { "$value": "#fee2e2" },
    "2": { "$value": "#ffedd5" },
    "3": { "$value": "#fef9c3" },
    "4": { "$value": "#dcfce7" },
    "5": { "$value": "#cffafe" },
    "6": { "$value": "#dbeafe" },
    "7": { "$value": "#ede9fe" },
    "8": { "$value": "#fae8ff" },
    "9": { "$value": "#ffe4e6" }
  },
  "font-size": {
    "$value": "{font-size.md}"
  },
  "font-weight": {
    "$value": "{font-weight.bold}"
  },
  "sm": {
    "$type": "object",
    "size": {
      "$value": "{space.xl}"
    },
    "font-size": {
      "$value": "{font-size.sm}"
    }
  },
  "lg": {
    "$type": "object",
    "size": {
      "$value": "{space.ul}"
    },
    "font-size": {
      "$value": "{font-size.lg}"
    }
  }
}
