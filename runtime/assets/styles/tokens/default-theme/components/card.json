{
  "$description": "Tokens for the Card component",
  "$type": "object",
  "background-color": {
    "$value": "{color.bg.surface}"
  },
  "color": {
    "$value": "{color.text.default}"
  },
  "border-color": {
    "$value": "{color.border.default}"
  },
  "border-width": {
    "$value": "{border-width.sm}"
  },
  "border-style": {
    "$value": "solid"
  },
  "border-radius": {
    "$value": "{border-radius.lg}"
  },
  "box-shadow": {
    "$value": "0 1px 2px rgb(15 23 42 / 0.03), 0 1px 3px rgb(15 23 42 / 0.06)"
  },
  "elevated": {
    "box-shadow": {
      "$value": "0 12px 24px rgb(15 23 42 / 0.10), 0 2px 6px rgb(15 23 42 / 0.05)"
    }
  },
  "max-width": {
    "$value": "content"
  },
  "padding": {
    "$value": "{space.lg}"
  },
  "header": {
    "$type": "object",
    "padding": {
      "$value": "{space.lg}"
    },
    "border-color": {
      "$value": "{color.border.default}"
    },
    "border-width": {
      "$value": "{border-width.sm}"
    }
  },
  "body": {
    "$type": "object",
    "padding": {
      "$value": "{card.padding}"
    }
  },
  "footer": {
    "$type": "object",
    "padding": {
      "$value": "{space.lg}"
    },
    "border-color": {
      "$value": "{color.border.default}"
    },
    "border-width": {
      "$value": "{border-width.sm}"
    }
  }
}
