{
  "$description": "Tokens for the Anchor component",
  "$type": "object",
  "active-font-weight": {
    "$value": "600"
  },
  "active-color": {
    "$value": "{color.primary}"
  },
  "border-color": {
    "$value": "{color.border.default}"
  },
  "indicator-color": {
    "$value": "{color.primary}"
  },
  "indicator-color-hover": {
    "$value": "{color.border-hover}"
  },
  "link-color": {
    "$value": "{color.text.muted}"
  },
  "link-color-hover": {
    "$value": "{color.text.default}"
  },
  "font-family": {
    "$value": "{font.base}"
  },
  "item-bg-hover": {
    "$value": "{color.bg.surface-hover}"
  },
  "item-bg-active": {
    "$value": "color-mix(in srgb, {color.primary} 8%, {color.bg.surface})"
  },
  "item-radius": {
    "$value": "{border-radius.base}"
  },
  "font-size": {
    "$value": "{font-size.base}"
  },
  "padding-block": {
    "$value": "{space.xs}"
  },
  "padding-inline": {
    "$value": "{space.sm}"
  },
  "indicator-width": {
    "$value": "2px"
  }
}
