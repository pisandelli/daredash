{
  "$description": "Tokens for the Popover component",
  "$type": "object",
  "bg": {
    "$value": "{color.bg.surface-elevated}"
  },
  "border-color": {
    "$value": "{color.border.default}"
  },
  "border-radius": {
    "$value": "{border-radius.lg}"
  },
  "shadow": {
    "$value": "0 12px 24px rgb(15 23 42 / 0.12), 0 2px 6px rgb(15 23 42 / 0.06)"
  },
  "padding": {
    "$value": "{space.md}"
  },
  "arrow-size": {
    "$value": "8px"
  },
  "color": {
    "$value": "{color.text.default}"
  },
  "z-index": {
    "$value": "{z-index.popover}"
  }
}
