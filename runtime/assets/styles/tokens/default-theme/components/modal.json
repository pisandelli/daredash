{
  "$description": "Tokens for the Modal (dialog) component",
  "$type": "object",
  "background-color": {
    "$value": "{color.bg.surface-elevated}"
  },
  "color": {
    "$value": "{color.text.default}"
  },
  "border-radius": {
    "$value": "{border-radius.xl}"
  },
  "box-shadow": {
    "$value": "0 20px 40px rgb(15 23 42 / 0.18), 0 4px 12px rgb(15 23 42 / 0.08)"
  },
  "inline-size": {
    "$description": "Preferred size of the modal",
    "$value": "70vw"
  },
  "max-inline-size": {
    "$description": "Max size of the modal",
    "$value": "37.5rem"
  },
  "z-index": {
    "$value": "{z-index.modal}"
  },
  "close-size": {
    "$description": "Size of the close icon",
    "$value": "{font-size.lg}"
  },
  "close": {
    "$type": "object",
    "color": {
      "$value": "{color.text.muted}"
    },
    "hover": {
      "color": {
        "$value": "{color.danger.600}"
      },
      "background-color": {
        "$value": "{color.danger.50}"
      }
    }
  },
  "backdrop": {
    "$description": "Styles for the modal's scrim (backdrop)",
    "$type": "object",
    "filter": {
      "$value": "blur(3px)"
    },
    "background-color": {
      "$value": "rgb(15 23 42 / 0.48)"
    }
  },
  "title": {
    "$description": "Styles for the 'title' slot",
    "$type": "object",
    "font-size": {
      "$value": "{font-size.lg}"
    },
    "font-weight": {
      "$value": "{font-weight.bold}"
    }
  },
  "body": {
    "$description": "Styles for the 'body' slot",
    "$type": "object",
    "font-family": {
      "$value": "{font.system}"
    }
  },
  "padding": {
    "$description": "Inner padding of the modal elements",
    "$value": "{space.md}"
  }
}
